---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: "tr" | "en";
}

const { title, description = "Mehmet Gümrah kişisel sitesi ve uygulama dokümantasyonu.", lang = "tr" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">Mehmet Gümrah</a>
        <nav class="nav" aria-label={lang === "tr" ? "Ana menü" : "Main navigation"}>
          <a href="/tr/apps/teknosales/privacy/">TR</a>
          <a href="/en/apps/teknosales/privacy/">EN</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
