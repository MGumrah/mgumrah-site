---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Mehmet Gümrah" description="Mehmet Gümrah kişisel website ve uygulama dokümantasyon merkezi.">
  <main class="hero">
    <section class="hero-inner" aria-label="Kişisel tanıtım">
      <p class="eyebrow">Kişisel Website</p>
      <h1>Mehmet<br />Gümrah</h1>
      <p class="summary">
        Merhaba, ben Mehmet Gümrah. Burası projelerimi, uygulamalarımı ve resmi dokümantasyon sayfalarını paylaşacağım kişisel web sitem.
      </p>
      <div class="actions" aria-label="Bağlantılar">
        <a class="button primary" href="/tr/apps/teknosales/privacy/">TeknoSales Gizlilik</a>
        <a class="button" href="https://github.com/MGumrah">GitHub</a>
      </div>
    </section>
  </main>
</BaseLayout>
