{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mgumrah-site",
  "compatibility_date": "2026-05-11",
  // The site is a static export; this entry point exists for the things a file
  // cannot do — take the /brief form, take an Android tester's e-mail, and run
  // the API behind /balim. Assets are matched before the Worker runs, so every
  // page on the site is still served without this script executing.
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "out",
    // panel.balim.cafe (README → "panel.balim.cafe"): şimdilik KAPALI. Alan adı
    // bağlanırken bu satır AÇILMALI — yoksa Cloudflare statik dosyaları (/tr/,
    // /borc/, robots.txt…) Worker'a hiç uğramadan sunar ve host kapısı
    // (worker/panel-host.ts) o sayfaları kapatamaz. Açıkken sitedeki HER istek
    // Worker'dan geçer (Workers istek kotasından sayılır). Alan adıyla aynı
    // commit'te açılır; scripts/balim-host-test.mjs ikisinin birlikte olduğunu denetler.
    // "run_worker_first": true,
    // Needed once "main" is set: the Worker hands anything it does not answer
    // back to the asset layer through this binding.
    "binding": "ASSETS"
  },
  // panel.balim.cafe (Custom Domain; Cloudflare DNS kaydını ve sertifikayı kendisi
  // açar). KAPALI: bu satırı açmak yukarıdaki run_worker_first ile birlikte ve
  // ayrı bir onayla yapılır. Alan adı app/balim/adres.ts → PANEL_ALAN_ADLARI'nda olmalı.
  // "routes": [{ "pattern": "panel.balim.cafe", "custom_domain": true }],
  // One namespace behind both forms: `brief:` keys are scoping answers,
  // `tester:` keys are Google Play closed-test sign-ups.
  "kv_namespaces": [
    {
      "binding": "BRIEF",
      "id": "68d5080295af479abf20591a830503d2"
    }
  ],
  // Balım (/balim) — ailenin kafe hazırlık paneli. Liste, iş, gider ve oturum
  // kayıtları D1'de; KV değil, çünkü dört kişi aynı listeyi aynı anda
  // düzenliyor ve KV'nin gecikmeli tutarlılığı bir eklemeyi dakikalarca
  // görünmez kılabiliyor.
  "d1_databases": [
    {
      "binding": "BALIM_DB",
      "database_name": "balim",
      "database_id": "68553c40-ff5d-4eed-9638-e18320b18297",
      "migrations_dir": "migrations/balim"
    },
    // /borc — kişisel borç takibi. Ayrı veritabanı: Balım'ın verisiyle aynı
    // yerde durmasın, biri silinirse/bozulursa öteki etkilenmesin.
    // Veritabanı `npx wrangler d1 create borc` ile açıldı (README → "/borc canlıya
    // alma"). Giriş yapılacak kullanıcı olmadığı sürece kimse giremez; veritabanı
    // yoksa/binding eksikse Worker /api/borc için 503 döner, site etkilenmez.
    {
      "binding": "BORC_DB",
      "database_name": "borc",
      "database_id": "8a518e18-f37b-49c6-bf2f-a51a8582cf83",
      "migrations_dir": "migrations/borc"
    }
  ],
  // Balım'a yüklenen fotoğraflar: yapay zeka görselleri, dükkanın hâli, ilham.
  "r2_buckets": [
    {
      "binding": "BALIM_GORSELLER",
      "bucket_name": "balim-gorseller"
    }
  ],
  // 06:00 UTC = 09:00 İstanbul: Balım'ın sabah hatırlatmaları (yaklaşan kira
  // günü, bugün biten iş). worker/index.ts → scheduled.
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
