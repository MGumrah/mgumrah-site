{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mgumrah-site",
  "compatibility_date": "2026-05-11",
  // The site is a static export; this entry point exists for the things a file
  // cannot do — take the /brief form, take an Android tester's e-mail, and run
  // the API behind /balim. Assets are matched before the Worker runs, so every
  // page on the site is still served without this script executing.
  "main": "worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "out",
    // Needed once "main" is set: the Worker hands anything it does not answer
    // back to the asset layer through this binding.
    "binding": "ASSETS"
  },
  // One namespace behind both forms: `brief:` keys are scoping answers,
  // `tester:` keys are Google Play closed-test sign-ups.
  "kv_namespaces": [
    {
      "binding": "BRIEF",
      "id": "68d5080295af479abf20591a830503d2"
    }
  ],
  // Balım (/balim) — ailenin kafe hazırlık paneli. Liste, iş, gider ve oturum
  // kayıtları D1'de; KV değil, çünkü dört kişi aynı listeyi aynı anda
  // düzenliyor ve KV'nin gecikmeli tutarlılığı bir eklemeyi dakikalarca
  // görünmez kılabiliyor.
  "d1_databases": [
    {
      "binding": "BALIM_DB",
      "database_name": "balim",
      "database_id": "68553c40-ff5d-4eed-9638-e18320b18297",
      "migrations_dir": "migrations/balim"
    }
  ],
  // Balım'a yüklenen fotoğraflar: yapay zeka görselleri, dükkanın hâli, ilham.
  "r2_buckets": [
    {
      "binding": "BALIM_GORSELLER",
      "bucket_name": "balim-gorseller"
    }
  ],
  // 06:00 UTC = 09:00 İstanbul: Balım'ın sabah hatırlatmaları (yaklaşan kira
  // günü, bugün biten iş). worker/index.ts → scheduled.
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
